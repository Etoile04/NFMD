# NFMD configuration (all optional — see scripts/etl/config.py Settings for defaults)
# Dev default targets local Docker PostgreSQL; override for production/remote.

# Database URL (used by ETL load and API)
NFMD_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Batch size for parameter loading (default 500)
#NFMD_BATCH_SIZE=500

# Source directory for extract (default ~/.openclaw/workspace/data/nuclear-materials-wiki/parameters)
#NFMD_SOURCE_DIR=

# Base directory for run artifacts (default data/imports/runs, relative to repo root)
#NFMD_RUNS_BASE=

# Integration-test database (host providing CREATE DATABASE rights; default targets docker nfmd-postgres)
#NFMD_TEST_DB_URL=postgresql://postgres:postgres@127.0.0.1:15432/postgres
